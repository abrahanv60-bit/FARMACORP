@page "/productos"
@using FarmaciaApp.Interfaces
@using FarmaciaApp.Models
@inject IRepository<Producto> ProductoRepository

<PageTitle>Gestión de Productos</PageTitle>

<h3>Catálogo de Medicamentos</h3>

<!-- Tabla de productos -->
@if (productos == null)
{
    <p><em>Cargando productos...</em></p>
}
else if (!productos.Any())
{
    <p class="text-muted">No hay productos registrados en la base de datos.</p>
}
else
{
    <table class="table table-striped table-hover mt-3">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Principio Activo</th>
                <th>Categoría</th>
                <th>Precio</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var prod in productos)
            {
                <tr>
                    <td>@prod.Id</td>
                    <td>@prod.Nombre</td>
                    <td>@prod.PrincipioActivo</td>
                    <td><span class="badge bg-info text-dark">@prod.Categoria</span></td>
                    <td>Bs. @prod.Precio.ToString("F2")</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private IEnumerable<Producto> productos = new List<Producto>();
    private Producto nuevoProducto = new Producto();

    protected override async Task OnInitializedAsync()
    {
        await CargarProductos();
    }

    private async Task CargarProductos()
    {
        // Consumo desacoplado mediante el repositorio genérico
        productos = await ProductoRepository.GetAllAsync();
    }

    private async Task GuardarProducto()
    {
        if (!string.IsNullOrWhiteSpace(nuevoProducto.Nombre) && !string.IsNullOrWhiteSpace(nuevoProducto.Categoria))
        {
            await ProductoRepository.AddAsync(nuevoProducto);
            await ProductoRepository.SaveChangesAsync();
            nuevoProducto = new Producto(); // Limpiar el formulario
            await CargarProductos(); // Recargar la lista
        }
    }
}