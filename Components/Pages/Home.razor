@page "/"
@using FarmaciaApp.Interfaces
@using FarmaciaApp.Models
@inject IRepository<Producto> ProductoRepository

<PageTitle>Dashboard - PharmaCorp</PageTitle>

<div class="container-fluid py-4">
    <!-- Banner de Bienvenida -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="card bg-primary text-white shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="display-6 fw-bold mb-1">¡Bienvenido a PharmaCorp! 💊</h1>
                    <p class="mb-0 text-white-50">Panel de control y gestión general del inventario farmacéutico.</p>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando métricas...</span>
            </div>
        </div>
    }
    else
    {
        <!-- Tarjetas de Métricas -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card shadow-sm border-0 border-start border-4 border-primary h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fw-bold small text-uppercase">Total Productos</span>
                            <h2 class="display-6 fw-bold my-1 text-dark">@totalProductos</h2>
                            <small class="text-success"><i class="bi bi-check-circle"></i> Registrados en sistema</small>
                        </div>
                        <div class="bg-primary-subtle text-primary p-3 rounded-circle fs-3">
                            📦
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 border-start border-4 border-info h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fw-bold small text-uppercase">Categorías</span>
                            <h2 class="display-6 fw-bold my-1 text-dark">@totalCategorias</h2>
                            <small class="text-muted">Líneas de productos</small>
                        </div>
                        <div class="bg-info-subtle text-info p-3 rounded-circle fs-3">
                            🏷️
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm border-0 border-start border-4 border-success h-100">
                    <div class="card-body d-flex align-items-center justify-content-between">
                        <div>
                            <span class="text-muted fw-bold small text-uppercase">Precio Promedio</span>
                            <h2 class="display-6 fw-bold my-1 text-dark">Bs. @precioPromedio.ToString("F2")</h2>
                            <small class="text-muted">Valor promedio por ítem</small>
                        </div>
                        <div class="bg-success-subtle text-success p-3 rounded-circle fs-3">
                            💰
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Acciones Rápidas y Vista Previa -->
        <div class="row g-4">
            <div class="col-lg-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-0 fw-bold fs-5 py-3">
                        ⚡ Accesos Rápidos
                    </div>
                    <div class="card-body d-flex flex-column gap-3">
                        <a href="Productos" class="btn btn-outline-primary text-start p-3 fw-semibold shadow-sm">
                            📋 Ver Catálogo Completo
                        </a>
                        <a href="Productos/Create" class="btn btn-primary text-start p-3 fw-semibold shadow-sm">
                            ➕ Registrar Nuevo Producto
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center py-3">
                        <span class="fw-bold fs-5">💊 Resumen de Productos</span>
                        <a href="Productos" class="btn btn-sm btn-link text-decoration-none">Ver catálogo</a>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Nombre</th>
                                        <th>Principio Activo</th>
                                        <th>Categoría</th>
                                        <th>Precio</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!productos.Any())
                                    {
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">No hay productos registrados aún.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var prod in productos.Take(5))
                                        {
                                            <tr>
                                                <td class="fw-bold">@prod.Nombre</td>
                                                <td>@prod.PrincipioActivo</td>
                                                <td><span class="badge bg-info text-dark">@prod.Categoria</span></td>
                                                <td>Bs. @prod.Precio.ToString("F2")</td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private IEnumerable<Producto> productos = new List<Producto>();
    private int totalProductos;
    private int totalCategorias;
    private decimal precioPromedio;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            productos = await ProductoRepository.GetAllAsync();
            totalProductos = productos.Count();
            totalCategorias = productos
                .Select(p => p.Categoria)
                .Where(c => !string.IsNullOrWhiteSpace(c))
                .Distinct()
                .Count();
                
            precioPromedio = productos.Any() ? productos.Average(p => p.Precio) : 0;
        }
        catch
        {
            productos = new List<Producto>();
        }
        finally
        {
            isLoading = false;
        }
    }
}