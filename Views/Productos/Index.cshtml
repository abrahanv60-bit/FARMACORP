@model IEnumerable<FarmaciaApp.Models.Producto>

@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fs-3">Catálogo de Productos</h2>
        <a asp-action="Create" class="btn btn-primary">+ Nuevo Producto</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Principio Activo</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>@item.PrincipioActivo</td>
                        <td><span class="badge bg-info text-dark">@item.Categoria</span></td>
                        <td>Bs. @item.Precio.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>