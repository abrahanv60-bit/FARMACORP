@model IEnumerable<FarmaciaApp.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fs-3">Productos</h2>
        
        <div class="d-flex gap-2">
            <!-- Botón para la Actividad 09 (Consumo AJAX vía Fetch) -->
            <button id="btnCargar" class="btn btn-info text-white">
                Cargar Inventario vía AJAX
            </button>

            <!-- Oculto para vendedores, visible solo para Admin -->
            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Create" class="btn btn-primary">+ Nuevo Producto</a>
            }
        </div>
    </div>

    <!-- Contenedor donde se cargarán dinámicamente los datos de la API -->
    <div id="listaProductos" class="mb-4"></div>

    <div class="table-responsive">
        <table class="table table-striped table-hover shadow-sm align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Principio Activo</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.Nombre</td>
                        <td>@item.PrincipioActivo</td>
                        <td><span class="badge bg-info text-dark">@item.Categoria</span></td>
                        <td>Bs. @item.Precio.ToString("F2")</td>
                        @if (User.IsInRole("Admin"))
                        {
                            <td>
                                <a class="btn btn-sm btn-warning" href="#">Editar</a>
                                <a class="btn btn-sm btn-danger" href="#">Borrar</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById("btnCargar").addEventListener("click", async () => {
            const contenedor = document.getElementById("listaProductos");
            
            // 1. Feedback visual (Spinner)
            contenedor.innerHTML = `
                <div class="d-flex align-items-center gap-2 text-info p-3 border rounded bg-light">
                    <div class="spinner-border spinner-border-sm" role="status"></div>
                    <span>Consultando Web API...</span>
                </div>`;

            try {
                // 2. Petición asíncrona a la Web API
                const respuesta = await fetch("/api/ProductosApi");
                
                if (!respuesta.ok) {
                    throw new Error(`Error en la red (${respuesta.status})`);
                }

                const datos = await respuesta.json(); // Serialización automática JSON
                contenedor.innerHTML = ""; // Limpiar spinner

                if (datos.length === 0) {
                    contenedor.innerHTML = '<div class="alert alert-warning">No hay productos en el inventario.</div>';
                    return;
                }

                // 3. Renderizado dinámico en el DOM
                datos.forEach(p => {
                    contenedor.innerHTML += `
                        <div class="alert alert-secondary d-flex justify-content-between align-items-center mb-2 shadow-sm">
                            <div>
                                <strong>${p.nombre}</strong> — Bs. ${p.precio}
                            </div>
                            <span class="badge bg-primary rounded-pill">Stock Total: ${p.stockActual}</span>
                        </div>`;
                });

            } catch (error) {
                contenedor.innerHTML = `<div class="alert alert-danger">Error: ${error.message}</div>`;
            }
        });
    </script>
}