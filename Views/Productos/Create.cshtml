@model FarmaciaApp.Models.Producto

@{
    ViewData["Title"] = "Registrar Producto";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <!-- Rejilla Mobile-First: ocupa el 100% en celular y 6 columnas en pantallas medianas -->
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0 fs-5">Registrar Nuevo Producto</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        <!-- Resumen general de errores -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Paracetamol 500mg" />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="PrincipioActivo" class="form-label fw-bold"></label>
                            <input asp-for="PrincipioActivo" class="form-control" placeholder="Ej: Paracetamol" />
                            <span asp-validation-for="PrincipioActivo" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Categoria" class="form-label fw-bold"></label>
                            <input asp-for="Categoria" class="form-control" placeholder="Ej: Analgésico" />
                            <span asp-validation-for="Categoria" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Precio" class="form-label fw-bold"></label>
                            <input asp-for="Precio" class="form-control" type="number" step="0.01" placeholder="0.00" />
                            <span asp-validation-for="Precio" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between pt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">Volver</a>
                            <button type="submit" class="btn btn-success">Guardar Registro</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}